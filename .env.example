# Copiar este archivo como .env y poner valores propios. El .env NUNCA se sube a GitHub.

# --- MySQL del proyecto (contenedor "mysql" del docker-compose) ---
MYSQL_ROOT_PASSWORD=cambiar_root
MYSQL_USER=etl_user
MYSQL_PASSWORD=cambiar_password
# Desde tu computador (scripts y notebooks) se entra por localhost:3307.
# Dentro de Docker, el compose cambia esto por mysql:3306 automáticamente.
MYSQL_HOST=localhost
MYSQL_PORT=3307
RAW_DB_NAME=saber11
DW_DB_NAME=saber11_dw_e2

# --- Carpetas ---
STAGING_DIR=data/staging
CSV_2019_PATH=data/input/saber11_2019.csv

# --- API datos.gov.co (opcional, Lauren) ---
SOCRATA_APP_TOKEN=

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
